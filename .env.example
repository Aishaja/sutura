# Copy this file to .env and fill in your values:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Mac/Linux)
#
# Then run:  npm run env
# That generates js/admin-env.js (gitignored) for the admin sign-in page.
#
# IMPORTANT: Admin email/password must match a user in Firebase Authentication
# (Console → Authentication → Users). Never deploy js/admin-env.js to public hosting.

ADMIN_EMAIL=your-admin@example.com
ADMIN_PASSWORD=your-secure-password

# Sign in automatically when opening admin.html (localhost only)
ADMIN_AUTO_LOGIN=false
